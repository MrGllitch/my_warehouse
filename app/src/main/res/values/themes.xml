<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MyWarehouse" parent="android:Theme.Material.Light.NoActionBar">
        <item name="colorPrimary">#FF0000</item>
        <item name="colorPrimaryDark">#00FF04</item>
        <item name="android:colorSecondary">#00FFFD</item>
        <item name="android:colorPrimary">#FFAA00</item>
        <item name="android:statusBarColor">@color/splash_black</item>

    </style>

    <style name="Theme.SplashScreen.MyWarehouse" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash</item>
        <item name="postSplashScreenTheme">@style/Theme.MyWarehouse</item>
        <item name="windowSplashScreenAnimationDuration">1800</item>

    </style>
</resources>